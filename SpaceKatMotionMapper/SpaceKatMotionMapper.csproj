<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFrameworks>net10.0;</TargetFrameworks>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <EnableEnumGeneratorInterceptor>true</EnableEnumGeneratorInterceptor>
        <ApplicationIcon>Assets\SpaceKatDevice.ico</ApplicationIcon>
        <NeutralLanguage>zh-Hans-CN</NeutralLanguage>
        <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
        <IsPackable>false</IsPackable>
        <Version>0.3.1</Version>
        <Authors>JustKTS</Authors>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

        <!-- 平台特定的编译符号 -->
        <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);WINDOWS</DefineConstants>
        <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(DefineConstants);LINUX</DefineConstants>
        <LangVersion>latestmajor</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>
    <ItemGroup>
        <TrimmerRootAssembly Include="SpaceKat.Shared" />
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="2ndLAB.ANGLE.Static" Version="7151.0.0-10.0.26100.0-1.79e529b" Condition="'$(PublishAot)' == 'true' And $(RuntimeIdentifier.StartsWith('win'))" />
        <PackageReference Include="2ndLAB.SkiaSharp.Static" Version="3.119.0-10.0.26100.0-1.1c7d845" Condition="'$(PublishAot)' == 'true' And $(RuntimeIdentifier.StartsWith('win'))" />
        <PackageReference Include="Avalonia" Version="12.0.2" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.0.2" />
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.2" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="H.InputSimulator" Version="1.5.0" />
        <PackageReference Include="Irihi.Ursa" Version="2.0.0" />
        <PackageReference Include="Irihi.Ursa.Themes.Semi" Version="2.0.0" />
        <PackageReference Include="CSharpFunctionalExtensions" Version="3.7.0" />
<!-- MS DI packages removed; migrated to Jab -->
        <PackageReference Include="NetEscapades.EnumGenerators" Version="1.0.0-beta21" />
        <PackageReference Include="Semi.Avalonia" Version="12.0.1" />
        <PackageReference Include="Semi.Avalonia.ColorPicker" Version="12.0.1" />
        <PackageReference Include="Semi.Avalonia.DataGrid" Version="12.0.0" />
        <PackageReference Include="Serilog" Version="4.3.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
        <PackageReference Include="ValueConverters.Avalonia" Version="3.1.22" />
        <PackageReference Include="Xaml.Behaviors.Interactions" Version="12.0.0" />
        <PackageReference Include="Jab" Version="0.12.0" PrivateAssets="all" />

    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\SpaceKat.KatMotionDomain\SpaceKat.KatMotionDomain.csproj" />
      <ProjectReference Include="..\SpaceKat.KatMotionRecognition\SpaceKat.KatMotionRecognition.csproj" />
      <ProjectReference Include="..\MetaKeyPresetsEditor\MetaKeyPresetsEditor.csproj" />
      <ProjectReference Include="..\SpaceKat.Shared\SpaceKat.Shared.csproj" />
      <ProjectReference Include="..\SpaceKatHIDWrapper\SpaceKatHIDWrapper.csproj" />
      <ProjectReference Include="..\Win32Helpers\Win32Helpers.csproj" />
      <ProjectReference Include="..\LinuxHelpers\LinuxHelpers.csproj" />
      <ProjectReference Include="..\PlatformAbstractions\PlatformAbstractions.csproj" />
    </ItemGroup>

    <ItemGroup>
        <DirectPInvoke Include="libHarfBuzzSharp" Condition="'$(PublishAot)' == 'true' And $(RuntimeIdentifier.StartsWith('win'))" />
        <DirectPInvoke Include="libSkiaSharp" Condition="'$(PublishAot)' == 'true' And $(RuntimeIdentifier.StartsWith('win'))" />
        <DirectPInvoke Include="av_libglesv2" Condition="'$(PublishAot)' == 'true' And $(RuntimeIdentifier.StartsWith('win'))" />
        <DirectPInvoke Include="HidApi" Condition="'$(PublishAot)' == 'true' And $(RuntimeIdentifier.StartsWith('win'))" />
    </ItemGroup>

    <ItemGroup>
        <NativeLibrary Include="..\SpaceKatHIDWrapper\hidapi.lib" Condition="'$(PublishAot)' == 'true' And $([MSBuild]::IsOSPlatform('Windows'))" />
        <NativeLibrary Include="opengl32.lib" Condition="$(RuntimeIdentifier.StartsWith('win'))" />
        <NativeLibrary Include="gdi32.lib" Condition="$(RuntimeIdentifier.StartsWith('win'))" />
        <NativeLibrary Include="dxgi.lib" Condition="$(RuntimeIdentifier.StartsWith('win'))" />
        <NativeLibrary Include="d3d9.lib" Condition="$(RuntimeIdentifier.StartsWith('win'))" />
        <NativeLibrary Include="dxguid.lib" Condition="$(RuntimeIdentifier.StartsWith('win'))" />
        <NativeLibrary Include="synchronization.lib" Condition="$(RuntimeIdentifier.StartsWith('win'))" />
    </ItemGroup>

    <Target Name="ExcludeStaticLibsFromPublish" AfterTargets="ComputeFilesToPublish" BeforeTargets="CopyFilesToPublishDirectory">
        <ItemGroup>
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(Extension)').ToLower()) == '.lib'" />
            <ContentWithTargetPath Remove="@(ContentWithTargetPath)" Condition="$([System.String]::Copy('%(Extension)').ToLower()) == '.lib'" />
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(FileName)%(Extension)' == 'libSkiaSharp.dll' And '$(PublishAot)' == 'true'" />
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(FileName)%(Extension)' == 'libHarfBuzzSharp.dll' And '$(PublishAot)' == 'true'" />
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(FileName)%(Extension)' == 'av_libglesv2.dll' And '$(PublishAot)' == 'true'" />
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(FileName)%(Extension)' == 'hidapi.dll' And '$(PublishAot)' == 'true' And $([MSBuild]::IsOSPlatform('Windows'))" />
            <ResolvedFileToPublish Include="..\SpaceKatHIDWrapper\hidapi.dll" Condition="'$(PublishAot)' != 'true' And $([MSBuild]::IsOSPlatform('Windows'))">
                <RelativePath>hidapi.dll</RelativePath>
                <AssetType>native</AssetType>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>

    <ItemGroup>
        <LinkerArg Include="/OPT:ICF" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
        <LinkerArg Include="/OPT:REF" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    </ItemGroup>

</Project>
